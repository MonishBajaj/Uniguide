{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Uniguide hand-verified course",
  "description": "One course per file. Every fact needs the official source URL, a verbatim evidence quote, who checked it and when. Files marked placeholder: true are illustrations only and never load into a hosted database.",
  "type": "object",
  "additionalProperties": false,
  "required": ["institution", "program", "cycles"],
  "properties": {
    "placeholder": { "type": "boolean", "default": false },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "country"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "city": { "type": "string" },
        "region": { "type": "string", "pattern": "^[A-Z0-9]{1,3}$" },
        "official_domain": { "type": "string" },
        "extra_official_domains": { "type": "array", "items": { "type": "string" } },
        "ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ror_id": { "type": "string" },
            "ipeds_unitid": { "type": "string" },
            "ukprn": { "type": "string" },
            "cricos_provider_code": { "type": "string" }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "level"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "level": { "enum": ["foundation", "diploma", "bachelor", "master", "doctorate"] },
        "isced_level": { "type": "integer", "minimum": 2, "maximum": 8 },
        "isced_f": { "type": "string", "pattern": "^\\d{2,4}$" },
        "cip": { "type": "string", "pattern": "^\\d{2}\\.\\d{4}$" },
        "field_label": { "type": "string" },
        "track": { "type": "string" },
        "delivery_mode": { "enum": ["on_campus", "online", "hybrid"] },
        "duration_months": { "type": "integer", "minimum": 1, "maximum": 120 },
        "required_credits": { "type": "number", "exclusiveMinimum": 0 },
        "credit_system": { "enum": ["us_credit", "ects", "uk_cats", "other"] },
        "languages_of_instruction": { "type": "array", "items": { "type": "string" } },
        "official_url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "cycles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "intake_year", "intake_term", "facts"],
        "properties": {
          "label": { "type": "string", "pattern": "^\\d{4}-[a-z0-9_]+$" },
          "intake_year": { "type": "integer" },
          "intake_term": { "type": "string" },
          "starts_on": { "type": "string", "format": "date" },
          "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "fields", "source_url", "evidence_quote", "verified_by", "verified_at"],
      "properties": {
        "subject": { "enum": ["requirement", "deadline", "cost_item", "fee_waiver"] },
        "fields": { "type": "object" },
        "source_url": { "type": "string", "pattern": "^https?://" },
        "evidence_quote": { "type": "string", "minLength": 8 },
        "verified_by": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date" },
        "second_checked_by": { "type": "string", "minLength": 1 },
        "second_checked_at": { "type": "string", "format": "date" },
        "status": { "enum": ["verified", "conflicting"], "default": "verified" }
      }
    }
  }
}
