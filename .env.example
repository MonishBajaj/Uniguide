# Copy to apps/web/.env.local (web) and worker/.env (worker). Never commit real values.

# --- Web (Next.js) ---------------------------------------------------------------
# Local values are printed by `pnpm db:start`. Hosted: Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Daily journey recompute (POST /api/cron/journeys). Shared with the database: its SHA-256 is stored in
# journey_config. The local seed accepts local-journey-token; see docs/SETUP.md for hosted setup.
JOURNEY_CRON_TOKEN=local-journey-token
# AI features (CV reader, setup chat, explanations, course Q&A, writing review) and the worker's
# page extraction. Optional locally; those features are disabled without it.
ANTHROPIC_API_KEY=
# Page extraction in the worker: gemini (default) or anthropic. Gemini needs GEMINI_API_KEY.
EXTRACTOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
# Courses whose pages were checked within this many days are not fetched again.
ENRICH_FRESH_DAYS=7
# Optional embeddings for the faculty matcher; full-text search is used without it.
VOYAGE_API_KEY=
# Optional: send parental-consent emails through Resend. Without it the link is logged to the
# server console in development.
RESEND_API_KEY=
EMAIL_FROM="Uniguide <noreply@example.com>"
# Local only: with no Resend key, the worker delivers emails to Mailpit (http://127.0.0.1:54324) instead.
MAILPIT_URL=

# --- Worker (Python) -------------------------------------------------------------
# The worker connects as the `ingest_worker` Postgres role, never with the service-role key.
WORKER_DATABASE_URL=postgresql://ingest_worker:ingest_worker_local@127.0.0.1:54322/postgres
# The seed loader is an operator task and connects as postgres.
OPERATOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# College Scorecard importer: free key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# OpenAlex faculty importer (recommended for regular use).
OPENALEX_API_KEY=
# Contact address sent in the worker's User-Agent so site owners can reach us.
CRAWLER_CONTACT=ops@example.com
# Reminder and update emails run as the notifier role.
NOTIFIER_DATABASE_URL=postgresql://notifier:notifier_local@127.0.0.1:54322/postgres
# Outcome analytics and the admission model read de-identified, consented outcomes as the analyst role.
ANALYST_DATABASE_URL=postgresql://analyst:analyst_local@127.0.0.1:54322/postgres
SITE_URL=http://localhost:3000

# Demo mode: set to true to switch sign-in and sign-up off. The navbar then switches between Guest, User and
# Parent by signing in as the seeded local accounts (supabase/seed.sql). Only works against a local Supabase.
AUTH_DISABLED=false

# --- Payments (season pass). Optional locally; checkout and webhooks answer 503 without them. ---
# Prices in the smallest unit: 1900 = USD 19.00, 149900 = INR 1,499.00.
PASS_PRICE_USD=1900
PASS_PRICE_INR=149900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shared with the database: its SHA-256 is stored in payment_config. Local seed accepts local-webhook-token.
PAYMENT_WEBHOOK_TOKEN=local-webhook-token
