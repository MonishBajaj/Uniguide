# Copy to apps/web/.env.local (web) and worker/.env (worker). Never commit real values.

# --- Web (Next.js) ---------------------------------------------------------------
# Local values are printed by `pnpm db:start`. Hosted: Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used by the CV-paste profile extraction. Optional locally; the feature is disabled without it.
ANTHROPIC_API_KEY=
# Optional: send parental-consent emails through Resend. Without it the link is logged to the
# server console in development.
RESEND_API_KEY=
EMAIL_FROM="Uniguide <noreply@example.com>"

# --- Worker (Python) -------------------------------------------------------------
# The worker connects as the `ingest_worker` Postgres role, never with the service-role key.
WORKER_DATABASE_URL=postgresql://ingest_worker:ingest_worker_local@127.0.0.1:54322/postgres
# The seed loader is an operator task and connects as postgres.
OPERATOR_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# College Scorecard importer: free key from https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Contact address sent in the worker's User-Agent so site owners can reach us.
CRAWLER_CONTACT=ops@example.com
# Reminder and update emails run as the notifier role.
NOTIFIER_DATABASE_URL=postgresql://notifier:notifier_local@127.0.0.1:54322/postgres
# Outcome analytics and the admission model read de-identified, consented outcomes as the analyst role.
ANALYST_DATABASE_URL=postgresql://analyst:analyst_local@127.0.0.1:54322/postgres
SITE_URL=http://localhost:3000
