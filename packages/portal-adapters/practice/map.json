  "pages": [
    {
      "id": "about-you",
      "path": "/apply/about-you",
      "kind": "form",
      "title": "Your details",
      "section": "About you",
      "fields": [
        {
          "role": "person.given_names",
          "label": "Given names",
          "control": "text",
          "required": true,
          "find": {
            "id": "field-given_names",
            "name": "given_names"
          },
          "source": null,
          "action": "student",
          "note": "R15: profiles hold no legal name."
        },
        {
          "role": "person.family_name",
          "label": "Family name",
          "control": "text",
          "required": true,
          "find": {
            "id": "field-family_name",
            "name": "family_name"
          },
          "source": null,
          "action": "student",
          "note": "R15."
        },
        {
          "role": "contact.email",
          "label": "Email address",
          "control": "email",
          "required": true,
          "find": {
            "id": "field-email",
            "name": "email"
          },
          "source": "contact.email",
          "action": "fill"
        },
        {
          "role": "person.date_of_birth",
          "label": "Date of birth",
          "control": "date",
          "required": true,
          "find": {
            "id": "field-date_of_birth",
            "name": "date_of_birth"
          },
          "source": null,
          "action": "student",
          "note": "R15: profiles hold only a birth month."
        },
        {
          "role": "contact.residence_country",
          "label": "Country you live in",
          "control": "select",
          "required": true,
          "find": {
            "id": "field-country_of_residence",
            "name": "country_of_residence"
          },
          "options": [
            {
              "value": "IN",
              "text": "India"
            },
            {
              "value": "GB",
              "text": "United Kingdom"
            },
            {
              "value": "US",
              "text": "United States"
            },
            {
              "value": "DE",
              "text": "Germany"
            },
            {
              "value": "NG",
              "text": "Nigeria"
            },
            {
              "value": "OTHER",
              "text": "Somewhere else"
            }
          ],
          "source": "contact.residenceCountry",
          "action": "fill",
          "note": "Option values are ISO codes; no match pauses."
        },
        {
          "role": "contact.phone",
          "label": "Phone number (optional)",
          "control": "tel",
          "required": false,
          "find": {
            "id": "field-phone",
            "name": "phone"
          },
          "source": null,
          "action": "student",
          "note": "R15."
        }
      ],
      "controls": {
        "continue": "save-continue",
        "save": "save-only",
        "back": "back"
      }
    },
    {
      "id": "schooling",
      "path": "/apply/schooling",
      "kind": "form",
      "title": "Your most recent school or college",
      "section": "Your education",
      "fields": [
        {
          "role": "education.school_name",
          "label": "Name of school or college",
          "control": "text",
          "required": true,
          "find": {
            "id": "field-school_name",
            "name": "school_name"
          },
          "source": null,
          "action": "student",
          "note": "Not in the profile."
        },
        {
          "role": "education.qualification",
          "label": "Qualification",
          "control": "select",
          "required": true,
          "find": {
            "id": "field-qualification",
            "name": "qualification"
          },
          "options": [
            {
              "value": "cbse_12",
              "text": "CBSE Class XII"
            },
            {
              "value": "isc_12",
              "text": "ISC Class XII"
            },
            {
              "value": "ib_diploma",
              "text": "IB Diploma"
            },
            {
              "value": "a_levels",
              "text": "A levels"
            },
            {
              "value": "bachelor_4yr",
              "text": "Bachelor's degree (4 years)"
            },
            {
              "value": "other",
              "text": "Another qualification"
            }
          ],
          "source": "education.qualification",
          "action": "confirm",
          "note": "Only an exact option match; otherwise pause."
        },
        {
          "role": "education.grade.scale",
          "label": "How your grade is given",
          "control": "select",
          "required": true,
          "find": {
            "id": "field-grade_scale",
            "name": "grade_scale"
          },
          "options": [
            {
              "value": "percentage",
              "text": "Percentage"
            },
            {
              "value": "gpa_4",
              "text": "GPA out of 4"
            },
            {
              "value": "gpa_10",
              "text": "GPA out of 10"
            },
            {
              "value": "ib_points",
              "text": "IB points out of 45"
            }
          ],
          "source": "education.grade.scale",
          "action": "confirm",
          "note": "Only an exact option match; no conversion."
        },
        {
          "role": "education.grade.value",
          "label": "Your overall grade",
          "control": "text",
          "required": true,
          "find": {
            "id": "field-grade_value",
            "name": "grade_value"
          },
          "hint": "Exactly as it appears on your marksheet.",
          "source": "education.grade",
          "action": "confirm",
          "note": "Exactly as entered, no conversion."
        },
        {
          "role": "education.still_studying",
          "label": "Are you still studying there?",
          "control": "radio",
          "required": true,
          "find": {
            "id": "field-still_studying",
            "name": "still_studying",
            "optionIds": {
              "yes": "field-still_studying-yes",
              "no": "field-still_studying-no"
            }
          },
          "options": [
            {
              "value": "yes",
              "text": "Yes"
            },
            {
              "value": "no",
              "text": "No"
            }
          ],
          "source": null,
          "action": "student"
        },
        {
          "role": "education.expected_completion",
          "label": "When do you expect to finish?",
          "control": "month",
          "required": true,
          "find": {
            "id": "field-expected_completion",
            "name": "expected_completion"
          },
          "showWhen": {
            "field": "still_studying",
            "equals": "yes"
          },
          "source": null,
          "action": "student"
        }
      ],
      "controls": {
        "continue": "save-continue",
        "save": "save-only",
        "back": "back"
      }
    },
    {
      "id": "tests",
      "path": "/apply/tests",
      "kind": "form",
      "title": "English language tests",
      "section": "Tests and activities",
      "fields": [
        {
          "role": "tests.english.taken",
          "label": "Have you taken an English language test?",
          "control": "radio",
          "required": true,
          "find": {
            "id": "field-english_test_taken",
            "name": "english_test_taken",
            "optionIds": {
              "yes": "field-english_test_taken-yes",
              "no": "field-english_test_taken-no"
            }
          },
          "options": [
            {
              "value": "yes",
              "text": "Yes"
            },
            {
              "value": "no",
              "text": "No"
            }
          ],
          "source": "testScores",
          "action": "confirm",
          "note": "Yes only when an English test score exists."
        },
        {
          "role": "tests.english.exam",
          "label": "Which test?",
          "control": "select",
          "required": true,
          "find": {
            "id": "field-english_test",
            "name": "english_test"
          },
          "options": [
            {
              "value": "ielts_academic",
              "text": "IELTS Academic"
            },
            {
              "value": "toefl_ibt",
              "text": "TOEFL iBT"
            },
            {
              "value": "pte_academic",
              "text": "PTE Academic"
            },
            {
              "value": "duolingo",
              "text": "Duolingo English Test"
            }
          ],
          "showWhen": {
            "field": "english_test_taken",
            "equals": "yes"
          },
          "source": "testScores[].exam",
          "action": "confirm",
          "note": "Only an exact option match."
        },
        {
          "role": "tests.english.total",
          "label": "Overall score",
          "control": "text",
          "required": true,
          "find": {
            "id": "field-english_overall",
            "name": "english_overall"
          },
          "showWhen": {
            "field": "english_test_taken",
            "equals": "yes"
          },
          "source": "testScores[].total",
          "action": "confirm",
          "note": "As recorded."
        },
        {
          "role": "tests.english.taken_on",
          "label": "Date you took it",
          "control": "date",
          "required": false,
          "find": {
            "id": "field-english_date",
            "name": "english_date"
          },
          "showWhen": {
            "field": "english_test_taken",
            "equals": "yes"
          },
          "source": "testScores[].takenOn",
          "action": "confirm"
        }
      ],
      "controls": {
        "continue": "save-continue",
        "save": "save-only",
        "back": "back"
      }
    },
    {
      "id": "activities",
      "path": "/apply/activities",
      "kind": "form",
      "title": "Activities",
      "section": "Tests and activities",
      "fields": [
        {
          "role": "activities[].role",
          "label": "What you did",
          "control": "text",
          "required": true,
          "find": {
            "idPattern": "field-activity_{n}_role",
            "namePattern": "activity_{n}_role"
          },
          "source": "activities[].title",
          "action": "confirm",
          "note": "One portal entry per CV entry the student picks."
        },
        {
          "role": "activities[].organisation",
          "label": "Organisation",
          "control": "text",
          "required": false,
          "find": {
            "idPattern": "field-activity_{n}_organisation",
            "namePattern": "activity_{n}_organisation"
          },
          "source": "activities[].organisation",
          "action": "confirm"
        },
        {
          "role": "activities[].description",
          "label": "Tell us about it",
          "control": "textarea",
          "required": false,
          "find": {
            "idPattern": "field-activity_{n}_description",
            "namePattern": "activity_{n}_description"
          },
          "maxlength": 300,
          "source": null,
          "action": "student",
          "note": "CV bullets are not this answer; the student writes it."
        }
      ],
      "group": {
        "name": "activity",
        "min": 1,
        "max": 5,
        "containerIdPattern": "activity-{n}",
        "add": "add-activity"
      },
      "controls": {
        "continue": "save-continue",
        "save": "save-only",
        "back": "back"
      }
    },
    {
      "id": "statement",
      "path": "/apply/statement",
      "kind": "form",
      "title": "Personal statement",
      "section": "Personal statement",
      "fields": [
        {
          "role": "essay.personal_statement",
          "label": "Why do you want to study this course?",
          "control": "textarea",
          "required": true,
          "find": {
            "id": "field-statement",
            "name": "statement"
          },
          "wordLimit": 650,
          "hint": "Up to 650 words. Write it yourself.",
          "source": "finalDraft",
          "action": "confirm",
          "note": "Paste only the student's own final draft, after confirmation, and only when the AI policy allows; never generated."
        }
      ],
      "controls": {
        "continue": "save-continue",
        "save": "save-only",
        "back": "back"
      }
